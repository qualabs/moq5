-            /* Update the wake up time for the connection */
-            if (coalesced_packet_size > 0 || cnx->cnx_state == picoquic_state_disconnected) {
+            /* Update the wake up time for the connection. Once the batch holds a
+             * packet, wake now even if this last attempt sent nothing: it went
+             * through the fast path, which does not compute the timers. */
+            if (coalesced_packet_size > 0 || *send_length > 0 ||
+                cnx->cnx_state == picoquic_state_disconnected) {
                 next_wake_time = current_time;
                 SET_LAST_WAKE(cnx->quic, PICOQUIC_SENDER);
             }
