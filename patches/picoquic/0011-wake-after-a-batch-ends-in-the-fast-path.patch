+/* A client that fills its congestion window in batches, as the packet loop
+ * does with GSO, and loses every packet must send again within one probe
+ * timeout of its last packet (RFC 9002, section 6.2), not wait for the idle
+ * timer.
+ */
+static test_api_stream_desc_t test_scenario_batch_flight_loss[] = {
+    { 4, 0, 1000000, 257 }
+};
+
+static int batch_flight_loss_send(picoquic_test_tls_api_ctx_t* test_ctx, uint64_t simulated_time, size_t* send_length)
+{
+    uint8_t send_buffer[16 * PICOQUIC_MAX_PACKET_SIZE];
+    struct sockaddr_storage addr_to;
+    struct sockaddr_storage addr_from;
+    int if_index = 0;
+    picoquic_connection_id_t log_cid;
+    picoquic_cnx_t* last_cnx = NULL;
+    size_t send_msg_size = 0;
+
+    return picoquic_prepare_next_packet_ex(test_ctx->qclient, simulated_time, send_buffer, sizeof(send_buffer),
+        send_length, &addr_to, &addr_from, &if_index, &log_cid, &last_cnx, &send_msg_size);
+}
+
+int batch_flight_loss_test(void)
+{
+    uint64_t simulated_time = 0;
+    uint64_t loss_mask = 0;
+    uint64_t last_sent_time = 0;
+    uint64_t repeat_time = 0;
+    uint64_t retransmit_timer = 0;
+    size_t send_length = 0;
+    picoquic_test_tls_api_ctx_t* test_ctx = NULL;
+    int ret = tls_api_init_ctx(&test_ctx, 0, PICOQUIC_TEST_SNI, PICOQUIC_TEST_ALPN, &simulated_time, NULL, NULL, 0, 0, 0);
+
+    if (ret == 0 && test_ctx == NULL) {
+        return PICOQUIC_ERROR_MEMORY;
+    }
+
+    if (ret == 0) {
+        ret = tls_api_connection_loop(test_ctx, &loss_mask, 0, &simulated_time);
+    }
+
+    if (ret == 0) {
+        ret = tls_api_synch_to_empty_loop(test_ctx, &simulated_time, 2048, 1, 1);
+    }
+
+    if (ret == 0) {
+        ret = test_api_init_send_recv_scenario(test_ctx, test_scenario_batch_flight_loss, sizeof(test_scenario_batch_flight_loss));
+    }
+
+    /* Nothing is delivered. The spacing lets the pacing bucket refill, so a
+     * batch carries several packets. */
+    for (int i = 0; ret == 0 && i < 1024 &&
+        test_ctx->cnx_client->path[0]->bytes_in_transit < test_ctx->cnx_client->path[0]->cwin; i++) {
+        simulated_time += 10000;
+        ret = batch_flight_loss_send(test_ctx, simulated_time, &send_length);
+        if (ret == 0 && send_length > 0) {
+            last_sent_time = simulated_time;
+        }
+    }
+
+    if (ret == 0) {
+        if (test_ctx->cnx_client->path[0]->bytes_in_transit < test_ctx->cnx_client->path[0]->cwin) {
+            DBG_PRINTF("%s", "Congestion window not filled, cannot test\n");
+            ret = -1;
+        }
+        else {
+            retransmit_timer = picoquic_current_retransmit_timer(test_ctx->cnx_client, test_ctx->cnx_client->path[0]);
+        }
+    }
+
+    /* Nothing comes back: the next packet the client sends is a repeat or a probe. */
+    for (int i = 0; ret == 0 && i < 1024 && repeat_time == 0 && TEST_CLIENT_READY &&
+        simulated_time < last_sent_time + PICOQUIC_MICROSEC_SILENCE_MAX; i++) {
+        uint64_t next_time = picoquic_get_next_wake_time(test_ctx->qclient, simulated_time);
+
+        if (next_time > simulated_time) {
+            simulated_time = next_time;
+        }
+        ret = batch_flight_loss_send(test_ctx, simulated_time, &send_length);
+        if (ret == 0 && send_length > 0) {
+            repeat_time = simulated_time;
+        }
+    }
+
+    if (ret == 0 && (repeat_time == 0 || repeat_time > last_sent_time + retransmit_timer)) {
+        DBG_PRINTF("Last packet sent at %" PRIu64 ", next at %" PRIu64 ", retransmit timer %" PRIu64 "\n",
+            last_sent_time, repeat_time, retransmit_timer);
+        ret = -1;
+    }
+
+    if (test_ctx != NULL) {
+        tls_api_delete_ctx(test_ctx);
+    }
+
+    return ret;
+}
